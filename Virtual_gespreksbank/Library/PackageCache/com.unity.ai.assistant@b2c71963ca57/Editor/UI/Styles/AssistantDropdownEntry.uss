.assistant-dropdown-entry {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px 6px 4px;
    min-height: 28px;
}

.assistant-dropdown-entry:hover {
    background-color: var(--muse-chat-popup-hover);
}

.assistant-dropdown-entry-checkmark {
    width: 12px;
    height: 12px;
    margin-right: 8px;
    visibility: hidden;
}

.assistant-dropdown-entry-checked .assistant-dropdown-entry-checkmark {
    visibility: visible;
}

.assistant-dropdown-entry-icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
}

.assistant-dropdown-entry-icon-hidden {
    display: none;
}

.assistant-dropdown-entry-label {
    flex-grow: 1;
    flex-shrink: 1;
    color: var(--muse-chat-text-primary);
}

.assistant-dropdown-entry-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.assistant-dropdown-entry-title-row {
    flex-direction: row;
    align-items: center;
}

.assistant-dropdown-entry-badge {
    border-width: 1px;
    border-color: var(--muse-chat-foregrounds-310);
    border-radius: 3px;
    padding: 0 5px;
    margin-left: 6px;
    font-size: 10px;
    color: var(--muse-chat-text-secondary);
    flex-shrink: 0;
}

.assistant-dropdown-entry-badge-new {
    background-color: var(--muse-chat-backgrounds-125);
    color: var(--muse-chat-text-primary);
}

.assistant-dropdown-entry-description {
    font-size: 11px;
    color: var(--muse-chat-text-secondary);
    white-space: normal;
    margin-top: 1px;
}

.assistant-dropdown-entry-secondary .assistant-dropdown-entry-label {
    color: var(--muse-chat-text-secondary);
}

.assistant-dropdown-entry-hidden {
    display: none;
}
