.assistant-dropdown-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px 2px 24px;
}

.assistant-dropdown-header-separated {
    border-top-width: 1px;
    border-color: var(--muse-chat-separator-line);
    margin-top: 4px;
}

.assistant-dropdown-header-title {
    -unity-font-style: bold;
    color: var(--muse-chat-text-primary);
    flex-shrink: 0;
}

.assistant-dropdown-header-description {
    font-size: 11px;
    color: var(--muse-chat-text-secondary);
    margin-left: 12px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.assistant-dropdown-header-title-row {
    flex-direction: column;
    align-items: flex-start;
    padding: 6px 10px 4px 10px;
}

.assistant-dropdown-header-title-row .assistant-dropdown-header-description {
    margin: 4px 0 0 0;
    white-space: normal;
    overflow: visible;
}

.assistant-dropdown-header-hidden {
    display: none;
}
